{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start backend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "backend:start"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Android\\Android Studio\\jbr"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "node",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "senyas-auth-backend@|node server.js",
          "endsPattern": "Auth API running on"
        }
      }
    }
  ]
}
